# Optional contact information for OpenStreetMap Nominatim usage identification.
# Configure with your real contact in your hosting provider; do not deploy this example value.
NOMINATIM_CONTACT_EMAIL=

# Optional override. The default identifies the app and its public repository.
# NOMINATIM_USER_AGENT=LeadScout/1.1 (+https://github.com/gerikah/LeadScout)

# Optional public Overpass API endpoint override. The default is overpass-api.de.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Supabase project URL and public anon key (safe to expose to the browser).
# The server reads these unprefixed names; Vite embeds the VITE_ variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret. Never add a VITE_ prefix or expose this key in browser code.
# Required to enable shared database-backed API limits and audit concurrency.
SUPABASE_SERVICE_ROLE_KEY=
