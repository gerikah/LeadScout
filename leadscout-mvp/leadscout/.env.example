# Optional contact information for OpenStreetMap Nominatim usage identification.
# Configure with your real contact in your hosting provider; do not deploy this example value.
NOMINATIM_CONTACT_EMAIL=

# Optional override. The default identifies the app and its public repository.
# NOMINATIM_USER_AGENT=LeadScout/1.1 (+https://github.com/gerikah/LeadScout)

# Optional public Overpass API endpoint override. The default is overpass-api.de.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
